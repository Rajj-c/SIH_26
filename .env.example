# Project base URL, e.g. https://your-project.supabase.co (without /rest/v1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Server-only random secret (at least 32 characters) for the optional notification delivery worker.
NOTIFICATION_JOB_SECRET=

# Optional link from the primary deployment to a separately deployed demo login.
EVALUATOR_DEMO_URL=
# Enable ONLY on the isolated demo deployment, never the team's project.
EVALUATOR_ACCESS_ENABLED=false
PRIMARY_SUPABASE_URL=
EVALUATOR_SUPABASE_URL=
# Four intentionally PUBLIC guest credentials; never paste team credentials here.
EVALUATOR_ACCOUNTS_JSON=
# Explicit opt-in for owner-approved public guest accounts in the current DB.
# Enable only after scripts/provision-shared-evaluators.mjs succeeds.
EVALUATOR_SHARED_GUESTS_ENABLED=false
